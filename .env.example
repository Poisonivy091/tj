# ---- Stock Data ----
# Finnhub (free: 60 calls/min) - price targets, analyst ratings, news, fundamentals
FINNHUB_API_KEY=your_finnhub_key_here
# Alpha Vantage (free: 25 calls/day) - company overview, earnings, extended hours
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here
# NewsAPI (free: 100 req/day) - broad financial news
NEWSAPI_KEY=your_newsapi_key_here
# Yahoo Finance - no key needed (prices, charts, pre/post market)
# SEC EDGAR - no key needed (10-K, 10-Q, 8-K filings, insider trades)

# ---- WhatsApp via CallMeBot (FREE) ----
CALLMEBOT_API_KEY=your_callmebot_key
CALLMEBOT_PHONE=your_phone_with_country_code

# ---- WhatsApp via Twilio (paid, more reliable) ----
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+1XXXXXXXXXX

# ---- AI ----
ANTHROPIC_API_KEY=your_claude_api_key

# ---- General ----
WHATSAPP_PROVIDER=callmebot
TJ_DB_PATH=tj.db
